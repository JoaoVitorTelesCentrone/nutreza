{
  "expo": {
    "name": "Nutreza Paciente",
    "slug": "nutreza-paciente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo-icon.png",
    "scheme": "nutreza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/logo-icon.png",
      "bundleIdentifier": "br.com.nutreza.paciente"
    },
    "android": {
      "package": "br.com.nutreza.paciente",
      "adaptiveIcon": {
        "backgroundColor": "#F0F3EE",
        "foregroundImage": "./assets/brand/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/logo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F3EE",
          "image": "./assets/brand/logo-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
