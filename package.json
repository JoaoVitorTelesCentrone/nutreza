{
  "name": "nutreza-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nutreza/web dev",
    "dev:web": "pnpm --filter @nutreza/web dev",
    "dev:mobile": "pnpm --filter @nutreza/mobile start",
    "build": "pnpm --filter @nutreza/web build",
    "build:mobile": "pnpm --filter @nutreza/mobile exec expo export --platform android --output-dir dist",
    "doctor:mobile": "expo-doctor apps/mobile",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm seed:foods && pnpm --filter @nutreza/web test:e2e",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/database.types.ts",
    "seed:foods": "node scripts/import-foods.mjs --meta data/taco-4.source.json --data data/taco-4.jsonl",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "expo-doctor": "1.20.4",
    "supabase": "2.119.0"
  }
}
