NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
GOOGLE_AUTH_ENABLED=false

# Agenda: use somente no servidor. Configure antes de ativar lembretes reais.
SUPABASE_SECRET_KEY=
CRON_SECRET=
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# PWA do paciente: a análise de fotos exige consentimento explícito e liberação por clínica.
PATIENT_PHOTO_AI_ENABLED=false
PATIENT_PHOTO_MODEL=

# Financeiro: chave de 32 bytes em Base64 gerada e guardada somente no servidor.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PSP_ENCRYPTION_KEY=

# Teca: somente no servidor. O modo simulado não precisa de chave.
OPENAI_API_KEY=
TECA_MODEL=gpt-6-astra

# Teleconsulta. Sem estas chaves, o ambiente local usa o provedor simulado.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WhatsApp Cloud API. Gere uma chave AES de 32 bytes em Base64 para cifrar tokens.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TERMS_APPROVED=false

# Assinatura da Nutreza. "simulated" fecha a jornada local sem cobrança externa.
SAAS_BILLING_MODE=simulated
